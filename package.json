    "lenis": "^1.3.25",
    "lucide-react": "^0.395.0",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shadcn": "^4.3.0",
    "simple-icons": "^16.17.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
